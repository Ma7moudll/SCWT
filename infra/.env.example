# ============================================================
# SCWT Docker Compose — environment variables
# Copy this file to infra/.env and fill in your values.
# NEVER commit infra/.env (it is git-ignored).
# The compose defaults are DEVELOPMENT ONLY.
# ============================================================

# ---- PostgreSQL ---------------------------------------------
POSTGRES_PASSWORD=scwt

# ---- MQTT (local mosquitto container) -----------------------
# The shipped infra/mosquitto/passwd contains ONLY the dev identity
# `backend` with password `scwt-dev-broker-pass`. For anything exposed
# beyond your machine, regenerate it:
#   mosquitto_passwd -b -c infra/mosquitto/passwd backend <strong-pass>
MQTT_PASSWORD=scwt-dev-broker-pass

# ---- Backend secrets ----------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me-in-production
STATION_API_KEY=scwt-dev-station-key
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
