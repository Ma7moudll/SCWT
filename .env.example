# =============================================================================
# SCWT — environment reference
# Copy to `.env` and adjust. Every service reads its own values from env.
# =============================================================================

# =============================================================================
# BACKEND (backend/)
# =============================================================================

# Development: PostgreSQL (or SQLite for a zero-dependency local run).
DATABASE_URL=postgresql+psycopg2://scwt:scwt@localhost:5432/scwt_db
# DATABASE_URL=sqlite:///./scwt.db

# MQTT broker. Host scripts/dev use 1886 locally; docker-compose serves 1883.
# Production (HiveMQ Cloud): MQTT_BROKER_HOST=<cluster host>, MQTT_TLS=true,
# port defaults to 8883 when TLS is on. Credentials are REQUIRED in production
# and must come from your secret store — never commit them.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1886
MQTT_USERNAME=
# ${MQTT_PASSWORD} — supply via secret env; never hardcode or commit.
MQTT_PASSWORD=
MQTT_TLS=false

# Development mode. ENVIRONMENT=production enables the startup secret guard:
# default JWT/station secrets, missing MQTT credentials, wildcard CORS,
# DEBUG/DEBUG_IMAGE_HASH/SEED_DEMO_USER all fail startup.
ENVIRONMENT=development
DEBUG=false

# Comma-separated exact origins allowed by CORS (never "*").
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8100

# Station-camera capture upload cap in bytes (default 8 MiB).
MAX_UPLOAD_BYTES=8388608

# Auth rate limiting: login 5/min per client, register 10/min.
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REGISTER_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# The standalone AI service (real ONNX classifier).
AI_SERVICE_URL=http://localhost:8052

# Never commit a production secret. Override per environment:
#   test:  TEST_ENV  ->  throwaway random value is fine
#   prod:  real, long, random, rotated secret
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256

# Email delivery for password reset / verification. `console` logs the
# message (development); `smtp` sends via the server below (credentials from
# your secret store only).
EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=noreply@scwt.local
PUBLIC_BASE_URL=http://localhost:3000

# Config-only seed at startup (faculties, station, routing policy, counter).
# Runtime stacks keep this ON so the routing/leaderboard config exists.
SEED_ON_STARTUP=true
# Opt-in demo/test account (demo@scwt.app / demo123, 45 pts).
#   OFF for real dev/prod DBs; ON only for the test suite and the software E2E.
SEED_DEMO_USER=false

DEBUG=false

# Deposit policy
MIN_DEPOSIT_WEIGHT_GRAMS=1.0
AI_HIGH_CONFIDENCE=0.80
AI_MEDIUM_CONFIDENCE=0.50
DEPOSIT_SESSION_TTL_SECONDS=300

# Debug-only byte-identity fingerprint route used by the hardware validation
# harness to prove station-camera captures arrive unchanged. Never enable in
# production.
DEBUG_IMAGE_HASH=false

# =============================================================================
# AI SERVICE (ai-service/)
# =============================================================================
# Real trained-model inference (production default).
AI_SERVICE_CLASSIFIER=real
AI_MODEL_PATH=ai-service/models/model.onnx
# Development-only test fixture (isolated; NEVER used by the real classifier).
# AI_SERVICE_CLASSIFIER=development
DEVELOPMENT_FORCE_CLASS=
DEVELOPMENT_FORCE_CONFIDENCE=
# Train/export a new model:  cd ai-service && pip install -r requirements-training.txt
#   && python -m app.training.train --data-dir data/raw

# =============================================================================
# HARDWARE SIMULATOR (hardware-simulator/)
# =============================================================================
STATION_ID=st-001
STATION_CODE=ST-001
SIMULATOR_MOVEMENT_TIME=0.3
SIMULATOR_SENSOR_NOISE=0.2
MIN_DEPOSIT_WEIGHT_GRAMS=1.0
SIMULATOR_RAMP_STEP=0.05          # set to 0 for instant ramps (tests/CI)

# =============================================================================
# MOBILE APP (mobile/ — pass via --dart-define, NOT .env)
# =============================================================================
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8100/api/v1
#   # Android emulator (host loopback is 10.0.2.2)
# flutter run --dart-define=API_BASE_URL=http://192.168.1.10:8100/api/v1
#   # Physical device (LAN IP of the dev machine)
#
# There is NO offline or demo mode anymore: the app always talks to the real
# backend and surfaces connection errors honestly (no silent demo/offline
# fallback).